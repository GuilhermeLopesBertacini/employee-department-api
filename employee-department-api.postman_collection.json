              "raw": "{{base_url}}/api/departamentos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "departamentos", "1"]
            }
          }
        },
        {
          "name": "Funcionários de um Departamento",
          "request": {
            "method": "GET",
            "url": {
