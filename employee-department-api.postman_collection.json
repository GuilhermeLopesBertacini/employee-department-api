            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tecnologia\",\n  \"descricao\": \"Departamento de TI\",\n  \"data_criacao\": \"2024-01-01\",\n  \"data_atualizacao\": null\n}"
            }
          }
        },
        {
          "name": "Atualizar Departamento",
          "request": {
